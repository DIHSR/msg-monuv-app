# Adicione ao ambiente do n8n (docker-compose / .env do n8n) e REINICIE o n8n.
# Se o n8n usa task runners externos (n8n 2.x), as variáveis NODE_FUNCTION_* vão no container do runner.

# --- obrigatórias para o n8n deste projeto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# --- Supabase
MONUV_SUPABASE_URL=https://SEU-PROJETO.supabase.co
MONUV_SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role — NUNCA no front
MONUV_SUPABASE_ANON_KEY=eyJ...           # só para o monitor do login demo

# --- Meta App
MONUV_META_APP_ID=000000000000000
MONUV_META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONUV_META_VERIFY_TOKEN=gere-um-token-aleatorio-longo
MONUV_GRAPH_VERSION=v24.0

# --- Coexistência (app WhatsApp Business + API): pedir contatos + histórico (até 180 dias) ao conectar.
# Só pode ser pedido 1x, até 24 h após a conexão. Grava o histórico em public.messages.
MONUV_COEX_SYNC=false

# --- Monitor do usuário demo (opcional, recomendado)
MONUV_DEMO_EMAIL=revisor@monuv.com.br
MONUV_DEMO_PASSWORD=...
