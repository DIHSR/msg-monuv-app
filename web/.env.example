# Copie para .env.local (desenvolvimento) ou cadastre no AWS Amplify (produção).
# Tudo aqui vai para o bundle do navegador: são valores PÚBLICOS por natureza.
# NUNCA coloque aqui: service_role key do Supabase, App Secret da Meta, token de cliente.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL completa da API do n8n (webhook "Webhook API" do workflow Monuv)
VITE_N8N_API_URL=https://n8n.seudominio.com.br/webhook/monuv/api

# Meta — App ID e Configuration ID do Embedded Signup (Facebook Login for Business → Configurations)
VITE_META_APP_ID=000000000000000
VITE_META_CONFIG_ID=000000000000000

# Opcional: versão da Graph API usada pelo SDK do Facebook (padrão v24.0)
# VITE_GRAPH_VERSION=v24.0
